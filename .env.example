TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://tesla.burnsbuilt.co/callback
TESLA_PUBLIC_HOSTNAME=tesla.burnsbuilt.co
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_REGION=na
TESLA_SCOPES=openid offline_access user_data vehicle_device_data vehicle_cmds vehicle_charging_cmds
TESLA_DEFAULT_DRIVER=Colin
TOKEN_STORE_PATH=.tokens.json
VEHICLE_COMMAND_PROXY_URL=

# --- Local time (poller overnight window, curfew, daily buckets) ---
FLEET_LOCAL_TZ=America/Chicago

# --- Home geofence: labels charging sessions + trip endpoints as "Home" ---
TESLA_HOME_LAT=
TESLA_HOME_LON=
TESLA_HOME_RADIUS_M=150

# --- Electricity rates, USD/kWh (per-charger-type session pricing) ---
ELEC_HOME_RATE=0.134
ELEC_SUPERCHARGER_RATE=0.42
ELEC_AWAY_AC_RATE=0.25

# --- Alerts via ntfy (subscribe to the topic in the ntfy app; empty = off) ---
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
SPEED_ALERT_MPH=85
CURFEW_START_HOUR=23
CURFEW_END_HOUR=5
# Comma-separated drivers for the Sunday 7 PM weekly digest
WEEKLY_DIGEST_DRIVERS=Carson

# --- Driver attribution ---
# Manual UI override expires after this many seconds (then schedule/learned rules apply)
DRIVER_OVERRIDE_TTL_S=43200
# Schedule rules: file at /data/driver_schedule.json (preferred) or inline JSON here.
# Example: [{"days":[0,1,2,3,4],"start":"07:00","end":"08:30","driver":"Carson"}]
DRIVER_SCHEDULE_JSON=
